# Copy to .env and replace the values. Use long random strings, e.g.:
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me
# Secret for hashing client IPs before storage (at least 16 characters).
IP_HASH_KEY=change-me-to-a-long-random-string

# Set to true only when the ad server is reachable solely through your reverse
# proxy / CDN, which then provides the client IP in X-Forwarded-For.
OPENAD_TRUST_PROXY=false
# Header with the client country set by your CDN, e.g. CF-IPCountry (Cloudflare).
OPENAD_GEO_COUNTRY_HEADER=

# Host port for the ad server API.
OPENAD_HTTP_PORT=8080
